{
  "name": "claude-code",
  "bin": "claude",
  "configDirs": [
    "~/.claude"
  ],
  "spawn": {
    "cmd": [
      "claude",
      "-p",
      "Read the file {taskFile} and follow its instructions exactly.",
      "--add-dir",
      "{cwd}",
      "--dangerously-skip-permissions"
    ],
    "cwdMode": "add-dir"
  },
  "authSignatures": [
    "unauthorized",
    "authentication failed",
    "failed to authenticate",
    "credit balance",
    "not logged in",
    "please run /login"
  ],
  "$comment-quotaSignatures": "usage-limit phrases: classified `quota`, quarantined until the reset the message names. DEFAULT_QUOTA_SIGNATURES (src/lib/quota.js) apply on top of these.",
  "quotaSignatures": [
    "hit your session limit",
    "hit your limit",
    "hit your usage limit"
  ],
  "outputExtraction": {
    "strategy": "event-stream"
  },
  "eventStream": {
    "format": "jsonl",
    "args": ["--output-format", "stream-json", "--verbose", "--forward-subagent-text"],
    "modelPaths": ["model", "message.model"],
    "silenceThresholdSec": 600,
    "$comment-toolKinds": "Claude Code 2.1 tool names (the tool_use `name`). Bash, Read, Write and ToolSearch appear in the real capture under tests/fixtures/home-351; the rest are the same CLI's built-in tools. ToolSearch, WebFetch, TodoWrite, Task and every MCP tool count as other.",
    "toolKinds": {
      "Bash": "command",
      "Read": "read",
      "Write": "edit",
      "Edit": "edit",
      "MultiEdit": "edit",
      "NotebookEdit": "edit",
      "Glob": "search",
      "Grep": "search",
      "WebSearch": "search"
    },
    "rules": [
      {
        "rootMatch": { "path": "type", "equals": "assistant" },
        "forEach": "message.content",
        "match": { "path": "type", "equals": "tool_use" },
        "idPaths": ["id"],
        "eventIdPaths": ["uuid", "message.id"],
        "toolCallIdPaths": ["id"],
        "toolNamePaths": ["name"],
        "argumentsPaths": ["input"],
        "providerAtPaths": ["timestamp"],
        "parentIdPaths": ["parent_tool_use_id"],
        "usagePaths": {
          "input": "message.usage.input_tokens",
          "cacheRead": "message.usage.cache_read_input_tokens",
          "cacheWrite": "message.usage.cache_creation_input_tokens",
          "output": "message.usage.output_tokens",
          "reasoning": "message.usage.output_tokens_details.thinking_tokens"
        },
        "kindPaths": ["name"],
        "summaryPaths": ["input.command", "input.file_path", "input.path", "input.pattern"],
        "status": "running"
      },
      {
        "rootMatch": { "path": "type", "equals": "user" },
        "forEach": "message.content",
        "match": { "path": "type", "equals": "tool_result" },
        "idPaths": ["tool_use_id"],
        "eventIdPaths": ["uuid"],
        "toolCallIdPaths": ["tool_use_id"],
        "resultPaths": ["content", "$root.tool_use_result.stdout"],
        "providerAtPaths": ["timestamp"],
        "parentIdPaths": ["parent_tool_use_id"],
        "kind": "tool",
        "statusPath": "is_error",
        "statusMap": { "true": "failed", "false": "completed" },
        "defaultStatus": "completed"
      },
      {
        "rootMatch": { "path": "type", "equals": "assistant" },
        "forEach": "message.content",
        "match": { "path": "type", "equals": "text" },
        "eventIdPaths": ["uuid"],
        "providerAtPaths": ["timestamp"],
        "parentIdPaths": ["parent_tool_use_id"],
        "usagePaths": {
          "input": "message.usage.input_tokens",
          "cacheRead": "message.usage.cache_read_input_tokens",
          "cacheWrite": "message.usage.cache_creation_input_tokens",
          "output": "message.usage.output_tokens",
          "reasoning": "message.usage.output_tokens_details.thinking_tokens"
        },
        "kind": "response",
        "summaryPaths": ["text"],
        "status": "completed"
      },
      {
        "rootMatch": { "path": "type", "equals": "result" },
        "eventIdPaths": ["uuid"],
        "durationMsPaths": ["duration_ms"],
        "usagePaths": {
          "input": "usage.input_tokens",
          "cacheRead": "usage.cache_read_input_tokens",
          "cacheWrite": "usage.cache_creation_input_tokens",
          "output": "usage.output_tokens",
          "reasoning": "usage.output_tokens_details.thinking_tokens",
          "costUsd": "total_cost_usd"
        },
        "kind": "result",
        "summaryPaths": ["result"],
        "status": "completed"
      }
    ],
    "usage": [{
      "match": { "path": "type", "equals": "result" },
      "mode": "last",
      "fields": {
        "sessionId": "session_id",
        "costUsd": "total_cost_usd",
        "standardRead": "usage.input_tokens",
        "cacheRead": "usage.cache_read_input_tokens",
        "cacheWrite5m": "usage.cache_creation.ephemeral_5m_input_tokens",
        "cacheWrite1h": "usage.cache_creation.ephemeral_1h_input_tokens",
        "output": "usage.output_tokens",
        "reasoning": "usage.output_tokens_details.thinking_tokens"
      },
      "inclusive": {
        "output": ["reasoning"]
      }
    }],
    "output": [
      { "match": { "path": "type", "equals": "result" }, "path": "result", "mode": "last" }
    ]
  },
  "$comment-meter": "the CALLER pool \u2014 competes in analyze/build, wins only when no delegate can take the lane",
  "meter": {
    "type": "reader",
    "window": "weekly+5h"
  },
  "costRank": 4,
  "lanes": [
    "analyze",
    "build",
    "chore"
  ],
  "capabilities": ["strong-analysis", "code-reading", "file-editing", "workflow-planning"],
  "knownModels": ["claude-fable-5", "claude-opus-5", "claude-sonnet-5", "claude-haiku-4-5"],
  "modelSelection": { "flag": "--model", "mode": "replace-or-append" },
  "$comment-reasoning": "verified from `claude --help` (Claude Code 2.1.263): `--effort <level>  Effort level for the current session (low, medium, high, xhigh, max)`. skipModels: `--help` does not state per-model support, so Haiku is excluded conservatively — re-verify before removing the exclusion. With no `reasoning` override anywhere, workers inherit whatever effortLevel the home settings.json sets.",
  "reasoning": {
    "flag": "--effort",
    "levels": ["low", "medium", "high", "xhigh", "max"],
    "defaults": { "high": "xhigh", "medium": "high", "low": "medium" },
    "skipModels": ["^claude-haiku-"]
  },
  "conversation": {
    "newArgs": ["--session-id", "{sessionId}"],
    "resumeArgs": ["--resume", "{sessionId}"]
  },
  "modelProfiles": [
    { "match": "(?:^|/)claude-fable-", "tier": "high", "qualityRank": 6, "autoRecommend": false, "pricing": { "inputUsdPerMillion": 10, "cacheReadUsdPerMillion": 1, "cacheWrite5mUsdPerMillion": 12.5, "cacheWrite1hUsdPerMillion": 20, "outputUsdPerMillion": 50 }, "pricingSource": "https://platform.claude.com/docs/en/about-claude/pricing", "pricingUpdatedAt": "2026-09-19" },
    { "match": "^claude-opus-(5|4-[5-8])$", "tier": "high", "qualityRank": 5, "pricing": { "inputUsdPerMillion": 5, "cacheReadUsdPerMillion": 0.5, "cacheWrite5mUsdPerMillion": 6.25, "cacheWrite1hUsdPerMillion": 10, "outputUsdPerMillion": 25 }, "pricingSource": "https://platform.claude.com/docs/en/about-claude/pricing", "pricingUpdatedAt": "2026-09-19" },
    { "match": "^claude-sonnet-5$", "tier": "medium", "qualityRank": 4, "pricing": { "inputUsdPerMillion": 2, "cacheReadUsdPerMillion": 0.2, "cacheWrite5mUsdPerMillion": 2.5, "cacheWrite1hUsdPerMillion": 4, "outputUsdPerMillion": 10 }, "pricingSource": "https://platform.claude.com/docs/en/about-claude/pricing", "pricingUpdatedAt": "2026-09-19" },
    { "match": "^claude-sonnet-", "tier": "medium", "qualityRank": 4 },
    { "match": "^claude-haiku-4-5$", "tier": "low", "qualityRank": 3, "pricing": { "inputUsdPerMillion": 1, "cacheReadUsdPerMillion": 0.1, "cacheWrite5mUsdPerMillion": 1.25, "cacheWrite1hUsdPerMillion": 2, "outputUsdPerMillion": 5 }, "pricingSource": "https://platform.claude.com/docs/en/about-claude/pricing", "pricingUpdatedAt": "2026-09-19" }
  ],
  "subscription": { "plan": null, "monthlyPriceUsd": null, "includedValueUsd": null, "quotaWindow": "weekly" },
  "flags": {
    "stealth": false,
    "isCaller": true
  },
  "$comment-timeout": "No implicit wall-clock timeout; callers may opt in with --timeout or workflow step.timeoutSec"
}
