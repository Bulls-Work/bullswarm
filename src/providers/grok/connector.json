{
  "name": "grok",
  "bin": "grok",
  "configDirs": [
    "~/.grok"
  ],
  "spawn": {
    "cmd": [
      "grok",
      "-p",
      "{taskFile}"
    ],
    "cwdMode": "add-dir"
  },
  "authSignatures": [
    "unauthorized",
    "invalid api key"
  ],
  "$comment-quotaSignatures": "empty on purpose: no grok-specific usage-limit wording has been observed yet, and the generic phrasings (rate limit exceeded, too many requests, quota exceeded) already come from DEFAULT_QUOTA_SIGNATURES in src/lib/quota.js.",
  "quotaSignatures": [],
  "outputExtraction": {
    "strategy": "event-stream"
  },
  "eventStream": {
    "format": "jsonl",
    "args": [
      "--output-format",
      "streaming-json"
    ],
    "silenceThresholdSec": 600,
    "rules": [
      {
        "rootMatch": {
          "path": "type",
          "equals": "tool_call"
        },
        "idPaths": [
          "toolCallId"
        ],
        "kindPaths": [
          "toolName",
          "title"
        ],
        "toolCallIdPaths": [
          "toolCallId"
        ],
        "toolNamePaths": [
          "toolName",
          "title"
        ],
        "argumentsPaths": [
          "rawInput"
        ],
        "summaryPaths": [
          "rawInput.command",
          "rawInput.file_path",
          "rawInput.path",
          "title"
        ],
        "statusPath": "status"
      },
      {
        "rootMatch": {
          "path": "type",
          "equals": "tool_call_update"
        },
        "idPaths": [
          "toolCallId"
        ],
        "kindPaths": [
          "toolName"
        ],
        "toolCallIdPaths": [
          "toolCallId"
        ],
        "toolNamePaths": [
          "toolName",
          "title"
        ],
        "resultPaths": [
          "rawOutput"
        ],
        "summaryPaths": [
          "rawOutput.command"
        ],
        "statusPath": "status"
      },
      {
        "rootMatch": {
          "path": "type",
          "equals": "text"
        },
        "kind": "response",
        "summaryPaths": [
          "data"
        ],
        "status": "streaming",
        "aggregate": "consecutive",
        "summaryMode": "concat"
      },
      {
        "rootMatch": {
          "path": "type",
          "equals": "usage"
        },
        "kind": "usage",
        "status": "completed",
        "usagePaths": {
          "input": "usage.input_tokens",
          "cacheRead": "usage.cache_read_input_tokens",
          "cacheWrite": "usage.cache_creation_input_tokens",
          "output": "usage.output_tokens",
          "reasoning": "usage.reasoning_tokens"
        }
      },
      {
        "rootMatch": {
          "path": "type",
          "equals": "end"
        },
        "eventIdPaths": [
          "requestId"
        ],
        "kind": "result",
        "status": "completed",
        "durationMsPaths": [
          "duration_ms"
        ],
        "usagePaths": {
          "input": "usage.input_tokens",
          "cacheRead": "usage.cache_read_input_tokens",
          "cacheWrite": "usage.cache_creation_input_tokens",
          "output": "usage.output_tokens",
          "reasoning": "usage.reasoning_tokens",
          "costUsd": "total_cost_usd"
        }
      }
    ],
    "output": [
      {
        "match": {
          "path": "type",
          "equals": "text"
        },
        "path": "data",
        "mode": "concat"
      }
    ],
    "$comment-usage": "verified 2026-09-21 against grok 1.0.13 and tests/fixtures/stream/grok-capture.jsonl, a real capture of the spawn argv (`grok -p <taskFile> --model grok-4.6 --session-id <uuid> --output-format streaming-json`, task 'Reply with the single word DONE.'): the final `end` line carries `sessionId`, `total_cost_usd` and `usage{input_tokens, cache_read_input_tokens, cache_creation_input_tokens, output_tokens, reasoning_tokens, total_tokens}`, each the sum of the per-request `usage` lines (85680+1280 input/cache over two requests). input_tokens EXCLUDES cache reads (input 85680 + cacheRead 1280 + output 265 = total_tokens 87225) and output_tokens INCLUDES reasoning (reasoning is not added to total_tokens, and the request whose only visible text was `DONE` reported output 124 with reasoning 123). No model id rides the end line, only a `modelUsage` map keyed by the served model.",
    "usage": [
      {
        "match": {
          "path": "type",
          "equals": "end"
        },
        "mode": "last",
        "fields": {
          "sessionId": "sessionId",
          "costUsd": "total_cost_usd",
          "standardRead": "usage.input_tokens",
          "cacheRead": "usage.cache_read_input_tokens",
          "cacheWrite": "usage.cache_creation_input_tokens",
          "output": "usage.output_tokens",
          "reasoning": "usage.reasoning_tokens"
        },
        "inclusive": {
          "output": [
            "reasoning"
          ]
        }
      }
    ]
  },
  "meter": {
    "type": "reader",
    "window": "weekly"
  },
  "costRank": 2,
  "lanes": [
    "analyze",
    "build",
    "chore"
  ],
  "capabilities": [
    "strong-analysis",
    "code-reading",
    "file-editing",
    "workflow-planning"
  ],
  "modelDiscovery": {
    "cmd": [
      "grok",
      "models"
    ],
    "parse": "bullets",
    "timeoutMs": 20000,
    "maxModels": 50
  },
  "knownModels": [
    "grok-4.6",
    "grok-4.5"
  ],
  "model": "grok-4.6",
  "modelSelection": {
    "flag": "--model",
    "mode": "replace-or-append"
  },
  "$comment-reasoning": "flag verified from `grok --help` (grok 1.0.13): `--reasoning-effort <EFFORT>  Reasoning effort for reasoning models  [aliases: --effort]`. Accepted values verified from the grok 1.0.13 binary's own validation message (`strings` on the executable): `invalid reasoning effort: (expected one of: none, minimal, low, medium, high, xhigh, max)`. `none` and `minimal` sit below bullswarm's common scale, so a request below `low` clamps up to `low`. Tier defaults mirror claude-code (high=xhigh, medium=high, low=medium).",
  "reasoning": {
    "flag": "--reasoning-effort",
    "levels": [
      "low",
      "medium",
      "high",
      "xhigh",
      "max"
    ],
    "defaults": {
      "high": "xhigh",
      "medium": "high",
      "low": "medium"
    }
  },
  "conversation": {
    "newArgs": [
      "--session-id",
      "{sessionId}"
    ],
    "resumeArgs": [
      "--resume",
      "{sessionId}"
    ]
  },
  "modelProfiles": [
    {
      "match": "^grok-4\\.6$",
      "tier": "high",
      "qualityRank": 5,
      "pricing": {
        "inputUsdPerMillion": 2,
        "cacheReadUsdPerMillion": 0.5,
        "outputUsdPerMillion": 6,
        "longContext": {
          "thresholdTokens": 200000,
          "inputUsdPerMillion": 4,
          "cacheReadUsdPerMillion": 1,
          "outputUsdPerMillion": 12
        }
      },
      "pricingSource": "https://docs.x.ai/developers/models/grok-4.6",
      "pricingUpdatedAt": "2026-09-20"
    },
    {
      "match": "^grok-4\\.5$",
      "tier": "medium",
      "qualityRank": 4
    }
  ],
  "subscription": {
    "plan": null,
    "monthlyPriceUsd": null,
    "includedValueUsd": null,
    "quotaWindow": "weekly"
  },
  "flags": {
    "stealth": false
  },
  "$comment-timeout": "No implicit wall-clock timeout; callers may opt in with --timeout or workflow step.timeoutSec",
  "$comment-meter": "weekly shared credit pool via billing endpoint; no 5h window exists on unified-billing accounts"
}
