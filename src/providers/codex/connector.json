{
  "name": "codex",
  "bin": "codex",
  "configDirs": [
    "~/.codex"
  ],
  "spawn": {
    "cmd": [
      "codex",
      "exec",
      "--skip-git-repo-check",
      "-s",
      "danger-full-access",
      "--add-dir",
      "{cwd}",
      "Read {taskFile} and follow the instructions."
    ],
    "cwdMode": "add-dir",
    "$comment-argv": "{cwd} is substituted by the watcher with the resolved target directory. `-s danger-full-access` because codex is the only connector that sandboxes writes to its workspace, and a workflow evidence action must write its structured candidate into the run's own state directory under the bullswarm home. Without it codex does the work, produces valid evidence, and still fails the attempt with EPERM — run wf-mu0q9bxz-01e488 on 2026-09-14 burned two attempts, about 26 minutes and their quota each, both `schema` with 'the sandbox denied writing it to the required .bullswarm path'. command-code already runs --yolo for the same reason."
  },
  "conversation": {
    "followUp": {
      "cmd": [
        "codex",
        "exec",
        "resume",
        "{sessionId}",
        "{prompt}"
      ],
      "eventStreamArgs": [
        "--json"
      ],
      "$comment": "Verified with `codex exec --help` and `codex exec resume --help`: resume accepts a session id followed by a prompt. The watcher supplies the thread_id from thread.started and sends exactly one recovery turn."
    }
  },
  "authSignatures": [
    "usage_credits_required",
    "unauthorized",
    "invalid api key"
  ],
  "$comment-quotaSignatures": "spent-window phrases. usage_credits_required is a spent window, not a broken credential: it classifies `quota` (checked before authSignatures) so the pool is quarantined until its reset instead of re-probed in 10 minutes.",
  "quotaSignatures": [
    "usage_credits_required",
    "usage limit"
  ],
  "$comment-throttleSignatures": "empty on purpose: no codex-specific transient throttle wording has been observed; the generic throttle phrasings (rate limit exceeded, rate_limit_exceeded, too many requests) come from DEFAULT_THROTTLE_SIGNATURES in src/lib/quota.js and are retried on this pool after a short backoff, never paused.",
  "throttleSignatures": [],
  "outputExtraction": {
    "strategy": "event-stream"
  },
  "eventStream": {
    "format": "jsonl",
    "args": [
      "--json"
    ],
    "silenceThresholdSec": 600,
    "$comment-toolKinds": "Item types of `codex exec --json` (codex-cli 0.154.0): command_execution and file_change in the real captures under tests/fixtures, web_search in the same item vocabulary. mcp_tool_call and todo_list count as other.",
    "toolKinds": {
      "command_execution": "command",
      "file_change": "edit",
      "web_search": "search"
    },
    "rules": [
      {
        "rootMatch": {
          "path": "type",
          "equals": "item.started"
        },
        "idPaths": [
          "item.id"
        ],
        "eventIdPaths": [
          "item.id"
        ],
        "toolCallIdPaths": [
          "item.id"
        ],
        "toolCallIdMatch": {
          "path": "item.type",
          "equals": "command_execution"
        },
        "toolNamePaths": [
          "item.type"
        ],
        "toolNameMatch": {
          "path": "item.type",
          "equals": "command_execution"
        },
        "argumentsPaths": [
          "item.command",
          "item.changes"
        ],
        "kindPaths": [
          "item.type"
        ],
        "kindMap": {
          "agent_message": "response"
        },
        "summaryPaths": [
          "item.command",
          "item.text",
          "item.changes.0.path"
        ],
        "status": "running"
      },
      {
        "rootMatch": {
          "path": "type",
          "equals": "item.completed"
        },
        "idPaths": [
          "item.id"
        ],
        "eventIdPaths": [
          "item.id"
        ],
        "toolCallIdPaths": [
          "item.id"
        ],
        "toolCallIdMatch": {
          "path": "item.type",
          "equals": "command_execution"
        },
        "toolNamePaths": [
          "item.type"
        ],
        "toolNameMatch": {
          "path": "item.type",
          "equals": "command_execution"
        },
        "argumentsPaths": [
          "item.command",
          "item.changes"
        ],
        "resultPaths": [
          "item.aggregated_output"
        ],
        "resultMatch": {
          "path": "item.type",
          "equals": "command_execution"
        },
        "kindPaths": [
          "item.type"
        ],
        "kindMap": {
          "agent_message": "response"
        },
        "summaryPaths": [
          "item.command",
          "item.text",
          "item.changes.0.path"
        ],
        "status": "completed"
      },
      {
        "rootMatch": {
          "path": "type",
          "equals": "turn.completed"
        },
        "kind": "result",
        "status": "completed",
        "usagePaths": {
          "input": "usage.input_tokens",
          "cacheRead": "usage.cached_input_tokens",
          "cacheWrite": "usage.cache_write_input_tokens",
          "output": "usage.output_tokens",
          "reasoning": "usage.reasoning_output_tokens"
        }
      }
    ],
    "usage": [
      {
        "match": { "path": "type", "equals": "thread.started" },
        "mode": "last",
        "fields": {
          "sessionId": "thread_id"
        }
      },
      {
        "match": { "path": "type", "equals": "turn.completed" },
        "mode": "last",
        "fields": {
          "standardRead": "usage.input_tokens",
          "cacheRead": "usage.cached_input_tokens",
          "cacheWrite": "usage.cache_write_input_tokens",
          "output": "usage.output_tokens",
          "reasoning": "usage.reasoning_output_tokens"
        },
        "inclusive": {
          "standardRead": ["cacheRead"],
          "output": ["reasoning"]
        }
      }
    ],
    "output": [
      {
        "match": {
          "path": "type",
          "equals": "item.completed"
        },
        "path": "item.text",
        "mode": "last"
      }
    ]
  },
  "meter": {
    "type": "reader",
    "window": "weekly"
  },
  "costRank": 3,
  "lanes": [
    "analyze",
    "build",
    "chore"
  ],
  "capabilities": [
    "strong-analysis",
    "code-reading",
    "file-editing",
    "workflow-planning"
  ],
  "modelDiscovery": {
    "$comment": "provider.mjs pages through Codex app-server model/list; this object supplies only the bounded timeout.",
    "protocol": "app-server-model-list",
    "timeoutMs": 15000
  },
  "$comment-knownModels": "Last-resort compatibility list for an old or failing CLI. Successful CLI discovery does not merge these entries.",
  "knownModels": [
    "gpt-5.6-sol",
    "gpt-5.6-terra",
    "gpt-5.6-luna",
    "gpt-5.5",
    "gpt-5.4",
    "gpt-5.4-mini",
    "gpt-5.3-codex"
  ],
  "modelSelection": {
    "flag": "--model",
    "mode": "replace-or-append"
  },
  "$comment-reasoning": "verified 2026-09-09 against codex-cli 0.153.4: `codex exec -c model_reasoning_effort=max --model gpt-5.6-luna` ran (exit 0), printed `reasoning effort: max`, and the session rollout recorded reasoning_effort \"max\"; the public config reference still lists only minimal|low|medium|high|xhigh. `minimal` is accepted by the CLI but sits below bullswarm's ladder and is not declared.",
  "reasoning": {
    "args": [
      "-c",
      "model_reasoning_effort={level}"
    ],
    "levels": [
      "low",
      "medium",
      "high",
      "xhigh",
      "max"
    ],
    "defaults": {
      "high": "high",
      "medium": "medium",
      "low": "low"
    }
  },
  "modelProfiles": [
    {
      "match": "^gpt-6(?:[.-].*)?-astra$",
      "tier": "high",
      "qualityRank": 6
    },
    {
      "match": "^gpt-5\\.6-sol$",
      "tier": "high",
      "qualityRank": 6,
      "pricing": {
        "inputUsdPerMillion": 4,
        "cacheReadUsdPerMillion": 0.4,
        "cacheWriteUsdPerMillion": 5,
        "outputUsdPerMillion": 20
      },
      "pricingSource": "https://developers.openai.com/api/docs/guides/prompt-caching",
      "pricingUpdatedAt": "2026-09-20"
    },
    {
      "match": "^gpt-5\\.(5|4)$",
      "tier": "high",
      "qualityRank": 5
    },
    {
      "match": "^gpt-5\\.6-terra$",
      "tier": "medium",
      "qualityRank": 4,
      "pricing": {
        "inputUsdPerMillion": 2,
        "cacheReadUsdPerMillion": 0.2,
        "cacheWriteUsdPerMillion": 2.5,
        "outputUsdPerMillion": 12
      },
      "pricingSource": "https://developers.openai.com/api/docs/guides/prompt-caching",
      "pricingUpdatedAt": "2026-09-20"
    },
    {
      "match": "^gpt-5\\.3-codex$",
      "tier": "medium",
      "qualityRank": 4,
      "pricing": {
        "inputUsdPerMillion": 1.75,
        "cacheReadUsdPerMillion": 0.175,
        "cacheWriteUsdPerMillion": 2.1875,
        "outputUsdPerMillion": 14
      },
      "pricingSource": "https://developers.openai.com/api/docs/guides/prompt-caching",
      "pricingUpdatedAt": "2026-09-20"
    },
    {
      "match": "^gpt-5\\.6-luna$",
      "tier": "low",
      "qualityRank": 3,
      "pricing": {
        "inputUsdPerMillion": 0.2,
        "cacheReadUsdPerMillion": 0.02,
        "cacheWriteUsdPerMillion": 0.25,
        "outputUsdPerMillion": 1.2
      },
      "pricingSource": "https://developers.openai.com/api/docs/guides/prompt-caching",
      "pricingUpdatedAt": "2026-09-20"
    },
    {
      "match": "mini",
      "tier": "low",
      "qualityRank": 2
    }
  ],
  "subscription": {
    "plan": null,
    "monthlyPriceUsd": null,
    "includedValueUsd": null,
    "quotaWindow": "weekly"
  },
  "flags": {
    "stealth": false
  },
  "$comment-timeout": "No implicit wall-clock timeout; callers may opt in with --timeout or workflow step.timeoutSec"
}
