{
  "name": "bullswarm",
  "version": "0.35.4",
  "description": "Route work across coding-agent CLI subscriptions — paced by live quota meters, verified by content, never trusting exit codes.",
  "type": "module",
  "bin": {
    "bullswarm": "./bin/bullswarm.js",
    "bullswarm-mcp": "./mcp/server.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "bin/",
    "src/",
    "connectors/",
    "providers/",
    "skill/",
    "mcp/",
    "mods/",
    "fixtures/",
    "data/",
    "docs/",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "GOAL.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "refresh:openrouter": "node scripts/refresh-openrouter-benchmarks.mjs",
    "refresh:epoch": "node scripts/refresh-epoch-benchmarks.mjs",
    "refresh:benchmarks": "npm run refresh:openrouter && npm run refresh:epoch",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bulls-Work/bullswarm.git"
  },
  "homepage": "https://github.com/Bulls-Work/bullswarm#readme",
  "bugs": {
    "url": "https://github.com/Bulls-Work/bullswarm/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "claude",
    "codex",
    "grok",
    "opencode",
    "quota",
