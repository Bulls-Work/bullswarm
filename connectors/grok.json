{
  "name": "grok",
  "bin": "grok",
  "configDirs": [
    "~/.grok"
  ],
  "spawn": {
    "cmd": [
      "grok",
      "-p",
      "{taskFile}"
    ],
    "cwdMode": "add-dir"
  },
  "authSignatures": [
    "unauthorized",
    "rate limit",
    "invalid api key"
  ],
  "outputExtraction": {
    "strategy": "event-stream"
  },
  "eventStream": {
    "format": "jsonl",
    "args": ["--output-format", "streaming-json"],
    "silenceThresholdSec": 600,
    "rules": [
      { "rootMatch": { "path": "type", "equals": "tool_call" }, "idPaths": ["toolCallId"], "kindPaths": ["toolName", "title"], "summaryPaths": ["rawInput.command", "rawInput.file_path", "rawInput.path", "title"], "statusPath": "status" },
      { "rootMatch": { "path": "type", "equals": "tool_call_update" }, "idPaths": ["toolCallId"], "kindPaths": ["toolName"], "summaryPaths": ["rawOutput.command"], "statusPath": "status" },
      { "rootMatch": { "path": "type", "equals": "text" }, "kind": "response", "summaryPaths": ["data"], "status": "streaming", "aggregate": "consecutive", "summaryMode": "concat" }
    ],
    "output": [
      { "match": { "path": "type", "equals": "text" }, "path": "data", "mode": "concat" }
    ]
  },
  "meter": {
    "type": "reader",
    "window": "weekly"
  },
  "costRank": 2,
  "lanes": [
    "analyze",
    "build",
    "chore"
  ],
  "capabilities": ["strong-analysis", "code-reading", "file-editing", "workflow-planning"],
  "modelDiscovery": { "cmd": ["grok", "models"], "parse": "bullets", "timeoutMs": 20000, "maxModels": 50 },
  "knownModels": ["grok-4.6", "grok-4.5"],
  "model": "grok-4.6",
  "modelSelection": { "flag": "--model", "mode": "replace-or-append" },
  "modelProfiles": [
    { "match": "^grok-4\\.6$", "tier": "high", "qualityRank": 5, "pricing": { "inputUsdPerMillion": 2, "cacheReadUsdPerMillion": 0.5, "outputUsdPerMillion": 6 }, "pricingSource": "https://docs.x.ai/developers/models/grok-4.6", "pricingUpdatedAt": "2026-08-27" },
    { "match": "^grok-4\\.5$", "tier": "medium", "qualityRank": 4 }
  ],
  "subscription": { "plan": null, "monthlyPriceUsd": null, "includedValueUsd": null, "quotaWindow": "weekly" },
  "flags": {
    "stealth": false
  },
  "$comment-timeout": "No implicit wall-clock timeout; callers may opt in with --timeout or workflow step.timeoutSec",
  "$comment-meter": "weekly shared credit pool via billing endpoint; no 5h window exists on unified-billing accounts"
}
