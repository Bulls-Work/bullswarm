{
  "name": "command-code",
  "bin": "command-code",
  "configDirs": [
    "~/.commandcode"
  ],
  "spawn": {
    "cmd": [
      "command-code",
      "-p",
      "--no-session",
      "--tools-all",
      "--yolo",
      "Read the file {taskFile} and follow its instructions exactly."
    ],
    "cwdMode": "add-dir"
  },
  "authSignatures": [
    "unauthorized",
    "authentication failed",
    "not authenticated",
    "cmd login"
  ],
  "outputExtraction": {
    "strategy": "stdout"
  },
  "meter": {
    "type": "reader",
    "window": "weekly+monthly+5h"
  },
  "costRank": 1,
  "lanes": [
    "build",
    "chore"
  ],
  "$comment-lanes": "cannot serve analyze (upstream 403 on the frontier model)",
  "flags": {
    "stealth": false
  },
  "timeoutSec": 900
}