{
  "name": "command-code",
  "bin": "command-code",
  "configDirs": ["~/.commandcode"],
  "spawn": {
    "cmd": ["command-code", "-p", "{taskFile}", "--add-dir", "{cwd}"],
    "cwdMode": "add-dir"
  },
  "authSignatures": ["unauthorized", "authentication failed"],
  "outputExtraction": { "strategy": "stdout" },
  "meter": { "type": "declared", "window": "5h" },
  "costRank": 1,
  "lanes": ["build", "chore"],
  "$comment-lanes": "cannot serve analyze (upstream 403 on the frontier model)",
  "flags": { "stealth": false },
  "timeoutSec": 900
}
